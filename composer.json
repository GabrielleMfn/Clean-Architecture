{
    "name": "hetic/parking-partage",
    "description": "Système de Parking Partagé - Clean Architecture",
    "type": "project",
    "require": {
        "php": "^8.0",
        "firebase/php-jwt": "^6.10",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Domain\\": "src/Domain/",
            "App\\UseCase\\": "src/UseCase/",
            "App\\Infrastructure\\": "src/Infrastructure/",
            "App\\Presentation\\": "src/Presentation/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
